<div class="container py-5">
  <div class="policy-page-wrapper" style="max-width: 820px; margin: 40px auto; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 48px 36px;">
    <nav class="breadcrumb mb-4" style="font-size: 0.85rem; color: var(--color-text-muted);">
      <a href="{{ routes.root_url }}" style="color: var(--color-text-muted); text-decoration: none;">Home</a> &rsaquo; <span>{{ policy.title }}</span>
    </nav>

    <h1 class="policy-title" style="font-size: 2.2rem; margin-bottom: 24px; color: var(--color-text-light);">{{ policy.title }}</h1>
    
    <div class="policy-body rte" style="line-height: 1.8; color: var(--color-text-muted); font-size: 1rem;">
      {{ policy.body }}
    </div>

    <div class="policy-footer mt-5 text-center" style="border-top: 1px solid var(--color-border); padding-top: 32px;">
      <h3 style="font-size: 1.25rem; margin-bottom: 12px; color: var(--color-text-light);">Ready to Upgrade Your Comfort?</h3>
      <p class="text-muted" style="margin-bottom: 20px;">Get the Ragaoon Ergonomic Gaming Chair with 51 cm pocket springs and 30-day risk-free in-home trial.</p>
      <a href="{{ routes.root_url }}#ProductOverview" class="btn btn-primary btn-lg">
        <span>Order Ragaoon Chair &bull; $89.00 USD</span>
        {% render 'icon', name: 'arrow-right' %}
      </a>
    </div>
  </div>
</div>
