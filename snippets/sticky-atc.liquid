{% comment %}
  Sticky Add to Cart Bar for Ragaoon Ergonomic Chair
{% endcomment %}

{% if settings.enable_sticky_atc %}
<div id="StickyATC" class="sticky-atc" aria-hidden="true">
  <div class="sticky-atc-container">
    <div class="sticky-atc-product">
      <div class="sticky-atc-thumb">
        <img id="StickyATCImage" src="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.07.32.png?v=1792454958" alt="Ragaoon Ergonomic Chair">
      </div>
      <div class="sticky-atc-info">
        <h4 class="sticky-atc-title">Ragaoon Ergonomic Gaming Chair</h4>
        <div class="sticky-atc-meta">
          <div class="star-rating-mini">
            {% for i in (1..5) %}
              {% render 'icon', name: 'star' %}
            {% endfor %}
            <span class="rating-num">4.9 &bull; Verified Buyers</span>
          </div>
          <span class="sticky-badge">150 kg (330 lbs) Load</span>
        </div>
      </div>
    </div>

    <div class="sticky-atc-actions">
      <div class="sticky-atc-price-wrap">
        <span class="sticky-price" id="StickyPrice">$89.00 USD</span>
        <s class="sticky-compare-price" id="StickyComparePrice">$139.00 USD</s>
        <span class="sticky-save-badge">Save $50</span>
      </div>

      <div class="sticky-variant-select">
        <select id="StickyVariantPicker" class="variant-select-dropdown">
          <option value="black" data-color="Black" selected>Black</option>
        </select>
      </div>

      <button id="StickyATCBtn" class="btn btn-primary sticky-btn-submit" type="button">
        {% render 'icon', name: 'cart' %}
        <span>Add To Cart &bull; $89</span>
      </button>
    </div>
  </div>
</div>
{% endif %}
