{% comment %}
  Sticky Add to Cart Bar for high conversion on mobile & desktop
{% endcomment %}

{% if settings.enable_sticky_atc %}
<div id="StickyATC" class="sticky-atc" aria-hidden="true">
  <div class="sticky-atc-container">
    <div class="sticky-atc-product">
      <div class="sticky-atc-thumb">
        <img id="StickyATCImage" src="https://images.unsplash.com/photo-1598550476439-6847785fcea6?w=160&auto=format&fit=crop&q=80" alt="JECQCUPG Ergonomic Chair">
      </div>
      <div class="sticky-atc-info">
        <h4 class="sticky-atc-title">JECQCUPG Ergonomic Reclining Gaming Chair</h4>
        <div class="sticky-atc-meta">
          <div class="star-rating-mini">
            {% for i in (1..5) %}
              {% render 'icon', name: 'star' %}
            {% endfor %}
            <span class="rating-num">4.9 (1,840+ reviews)</span>
          </div>
          <span class="sticky-badge">400 lbs Rated</span>
        </div>
      </div>
    </div>

    <div class="sticky-atc-actions">
      <div class="sticky-atc-price-wrap">
        <span class="sticky-price" id="StickyPrice">$199.99</span>
        <s class="sticky-compare-price" id="StickyComparePrice">$289.99</s>
        <span class="sticky-save-badge">Save $90</span>
      </div>

      <div class="sticky-variant-select">
        <select id="StickyVariantPicker" class="variant-select-dropdown">
          <option value="arctic-black" data-color="Arctic Black" selected>Arctic Black</option>
          <option value="crimson-red" data-color="Crimson Red">Crimson Red</option>
          <option value="jet-black" data-color="Jet Black">Jet Black</option>
          <option value="arctic-white" data-color="Arctic White">Arctic White</option>
        </select>
      </div>

      <button id="StickyATCBtn" class="btn btn-primary sticky-btn-submit" type="button">
        {% render 'icon', name: 'cart' %}
        <span>Add To Cart</span>
      </button>
    </div>
  </div>
</div>
{% endif %}
