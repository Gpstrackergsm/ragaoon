<section class="ergonomics-section" id="Ergonomics">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">Anatomical Engineering</span>
      <h2 class="section-title">7-Point Orthopedic Body Support</h2>
      <p class="section-desc">
        Designed in collaboration with biomechanical researchers to eliminate the pressure hotspots that cause chronic neck cramps, pinched sciatic nerves, and lumbar stiffness.
      </p>
    </div>

    <div class="ergonomics-grid">
      <!-- Zone 1 -->
      <div class="ergo-card">
        <div class="ergo-icon-box">01</div>
        <div class="ergo-content">
          <h3 class="ergo-title">Contoured Headrest</h3>
          <p class="ergo-text">Cradles the C1-C7 cervical vertebrae to release tension in trapezius muscles during intense focus sessions.</p>
        </div>
      </div>

      <!-- Zone 2 -->
      <div class="ergo-card">
        <div class="ergo-icon-box">02</div>
        <div class="ergo-content">
          <h3 class="ergo-title">Thoracic Shoulder Cradle</h3>
          <p class="ergo-text">Wide winged backrest supports shoulder blades without forcing hunched posture or restricting thoracic expansion.</p>
        </div>
      </div>

      <!-- Zone 3 -->
      <div class="ergo-card">
        <div class="ergo-icon-box">03</div>
        <div class="ergo-content">
          <h3 class="ergo-title">Adaptive Lumbar Curve</h3>
          <p class="ergo-text">Conforms dynamically to the natural lordotic curve of your lower spine to take the weight off your lumbar discs.</p>
        </div>
      </div>

      <!-- Zone 4 -->
      <div class="ergo-card ergo-card-highlight">
        <div class="ergo-icon-box">04</div>
        <div class="ergo-content">
          <h3 class="ergo-title">Synchronized Linkage Armrests</h3>
          <p class="ergo-text">Pivots and glides in tandem with the backrest. Softly padded with high-resilience PU foam to prevent carpal tunnel.</p>
        </div>
      </div>

      <!-- Zone 5 -->
      <div class="ergo-card ergo-card-highlight">
        <div class="ergo-icon-box">05</div>
        <div class="ergo-content">
          <h3 class="ergo-title">51cm Flat Wingless Pocket Spring Seat</h3>
          <p class="ergo-text">No sharp side bolsters pinching your thighs! Built like a luxury mattress with 16 pocket springs. Sit cross-legged with zero restriction.</p>
        </div>
      </div>

      <!-- Zone 6 -->
      <div class="ergo-card">
        <div class="ergo-icon-box">06</div>
        <div class="ergo-content">
          <h3 class="ergo-title">SGS Class-4 Heavy Duty Gas Lift</h3>
          <p class="ergo-text">Nitrogen-charged, explosion-proof cylinder rated for up to 400 lbs (181 kg). Smooth, millimeter-accurate height adjustment.</p>
        </div>
      </div>

      <!-- Zone 7 -->
      <div class="ergo-card">
        <div class="ergo-icon-box">07</div>
        <div class="ergo-content">
          <h3 class="ergo-title">Retractable Padded Footrest</h3>
          <p class="ergo-text">Extends effortlessly when reclining to 135° to elevate your calves, boosting blood circulation and reducing leg swelling.</p>
        </div>
      </div>
    </div>

    <!-- Live Guarantee Callout -->
    <div class="ergo-cta-banner">
      <div class="cta-banner-text">
        <h4>Experience the Difference in Your Daily Productivity</h4>
        <p>Try the JECQCUPG chair in your home or office for 30 days. Feel the relief or receive a 100% refund.</p>
      </div>
      <a href="#ProductOverview" class="btn btn-primary">Upgrade Your Seat Now</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "7-Point Ergonomics",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "7-Point Orthopedic Body Support"
    }
  ],
  "presets": [
    {
      "name": "7-Point Ergonomics"
    }
  ]
}
{% endschema %}
