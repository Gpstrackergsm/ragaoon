<section class="ergonomics-section" id="Ergonomics">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">Anatomical Engineering</span>
      <h2 class="section-title">7-Point Orthopedic Body Support</h2>
      <p class="section-desc">
        Engineered by Ragaoon to eliminate the pressure hotspots that cause chronic neck cramps, pinched sciatic nerves, and lumbar stiffness during long sessions.
      </p>
    </div>

    <div class="ergonomics-grid">
      <!-- Zone 1 -->
      <div class="ergo-card">
        <div class="ergo-icon-box">01</div>
        <div class="ergo-content">
          <h3 class="ergo-title">Contoured Headrest</h3>
          <p class="ergo-text">Cradles the cervical vertebrae to release tension in upper neck and trapezius muscles.</p>
        </div>
      </div>

      <!-- Zone 2 -->
      <div class="ergo-card">
        <div class="ergo-icon-box">02</div>
        <div class="ergo-content">
          <h3 class="ergo-title">Thoracic Shoulder Support</h3>
          <p class="ergo-text">Wide contoured backrest supports shoulder blades without forcing hunched posture or shoulder strain.</p>
        </div>
      </div>

      <!-- Zone 3 -->
      <div class="ergo-card">
        <div class="ergo-icon-box">03</div>
        <div class="ergo-content">
          <h3 class="ergo-title">Ergonomic Lumbar Curve</h3>
          <p class="ergo-text">Conforms dynamically to the natural curve of your spine to take the pressure off your lower back discs.</p>
        </div>
      </div>

      <!-- Zone 4 -->
      <div class="ergo-card ergo-card-highlight">
        <div class="ergo-icon-box">04</div>
        <div class="ergo-content">
          <h3 class="ergo-title">Synchronized Linkage Armrests</h3>
          <p class="ergo-text">Pivots and glides in tandem with the backrest. Softly padded with high-resilience PU foam to prevent carpal tunnel.</p>
        </div>
      </div>

      <!-- Zone 5 -->
      <div class="ergo-card ergo-card-highlight">
        <div class="ergo-icon-box">05</div>
        <div class="ergo-content">
          <h3 class="ergo-title">51 cm Flat Wingless Pocket Spring Seat</h3>
          <p class="ergo-text">No sharp side wings pinching your thighs! Built with 16 pocket springs and high-density foam. Sit cross-legged with zero restriction.</p>
        </div>
      </div>

      <!-- Zone 6 -->
      <div class="ergo-card ergo-card-highlight">
        <div class="ergo-icon-box">06</div>
        <div class="ergo-content">
          <h3 class="ergo-title">Reinforced Steel Frame & Gas Lift</h3>
          <p class="ergo-text">Heavy-duty steel construction with 5-star base rated for up to 150 kg (330 lbs). Smooth, silent height adjustment.</p>
        </div>
      </div>

      <!-- Zone 7 -->
      <div class="ergo-card">
        <div class="ergo-icon-box">07</div>
        <div class="ergo-content">
          <h3 class="ergo-title">Full Hip & Thigh Weight Distribution</h3>
          <p class="ergo-text">Distributes body weight evenly across the 51 cm seating area to boost circulation and eliminate pressure points.</p>
        </div>
      </div>
    </div>

    <!-- Live Guarantee Callout -->
    <div class="ergo-cta-banner">
      <div class="cta-banner-text">
        <h4>Experience the Difference in Your Daily Productivity</h4>
        <p>Try the Ragaoon chair in your home or office for 30 days. Feel the relief or receive a 100% refund.</p>
      </div>
      <a href="{{ routes.root_url }}#ProductOverview" class="btn btn-primary">Upgrade to Ragaoon ($89)</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "7-Point Ergonomics",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "7-Point Orthopedic Body Support"
    }
  ],
  "presets": [
    {
      "name": "7-Point Ergonomics"
    }
  ]
}
{% endschema %}
