<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-top-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo">
          <span class="logo-mark">ragaoon</span>
          <span class="logo-sub">ERGONOMICS</span>
        </a>
        <p class="footer-tagline">
          Upgrade your gaming setup or workspace with the Ragaoon Ergonomic Gaming Chair. Featuring a spacious 51 cm wingless seat, sofa-grade pocket springs, and 90°–135° recline with synchronized armrests.
        </p>
        <div class="footer-social-icons">
          {% if settings.social_instagram_link != blank %}
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">IG</a>
          {% endif %}
          {% if settings.social_youtube_link != blank %}
            <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube">YT</a>
          {% endif %}
          {% if settings.social_tiktok_link != blank %}
            <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok">TT</a>
          {% endif %}
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="footer-links-col">
        <h4 class="footer-col-heading">Quick Links</h4>
        <ul class="footer-links-list">
          <li><a href="#ProductOverview">Order Ragaoon Chair ($89)</a></li>
          <li><a href="#VideoShowcase">Watch Video Demo</a></li>
          <li><a href="#ReclineShowcase">90°–135° Recline System</a></li>
          <li><a href="#Ergonomics">7-Point Support Anatomy</a></li>
          <li><a href="#SpringSeat">Pocket Spring Cushion</a></li>
          <li><a href="#Specs">Technical Specifications</a></li>
          <li><a href="#Reviews">Verified Reviews (4.9★)</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Care -->
      <div class="footer-links-col">
        <h4 class="footer-col-heading">Customer Care</h4>
        <ul class="footer-links-list">
          <li><a href="#FAQ">Frequently Asked Questions</a></li>
          <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
          <li><a href="/policies/refund-policy">30-Day Risk-Free Trial & Returns</a></li>
          <li><a href="/policies/terms-of-service">Warranty Information</a></li>
          <li><a href="/policies/privacy-policy">Privacy & Security</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter -->
      <div class="footer-newsletter-col">
        <h4 class="footer-col-heading">Join The Ragaoon Club</h4>
        <p>Subscribe for exclusive ergonomics insights, chair setup tips, and VIP-only offers.</p>
        <form class="footer-newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing to Ragaoon! Check your inbox.');">
          <input type="email" placeholder="Enter your email address" required class="newsletter-input">
          <button type="submit" class="btn btn-primary newsletter-btn">Subscribe</button>
        </form>
      </div>
    </div>

    <div class="footer-bottom-bar">
      <div class="footer-copyright">
        &copy; {{ 'now' | date: '%Y' }} Ragaoon Ergonomics. All rights reserved.
      </div>
      <div class="footer-payment-badges">
        <span>Visa</span>
        <span>Mastercard</span>
        <span>Amex</span>
        <span>Apple Pay</span>
        <span>Google Pay</span>
        <span>Shop Pay</span>
        <span>Klarna</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
