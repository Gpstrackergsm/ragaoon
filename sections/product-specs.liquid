<section class="specs-section" id="Specs">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">Precision Dimensions</span>
      <h2 class="section-title">Ragaoon Specifications & Engineering Blueprint</h2>
      <p class="section-desc">
        Engineered for lasting comfort, flexible seating, and reliable support for gamers, professionals, and home offices.
      </p>
    </div>

    <div class="specs-grid">
      <div class="specs-card">
        <h3 class="specs-card-title">Dimensions & Geometry</h3>
        <dl class="specs-dl">
          <div class="specs-row">
            <dt>Product Dimensions:</dt>
            <dd>55.3" D &times; 28.27" W &times; 28.28" H</dd>
          </div>
          <div class="specs-row">
            <dt>Seat Cushion Width:</dt>
            <dd>51 cm &mdash; Flat Wingless Design</dd>
          </div>
          <div class="specs-row">
            <dt>Seat Seating Freedom:</dt>
            <dd>Zero Side Wings (Sit Cross-Legged)</dd>
          </div>
          <div class="specs-row">
            <dt>Reclining Range:</dt>
            <dd>90&deg; &ndash; 135&deg; Adjustable Backrest</dd>
          </div>
          <div class="specs-row">
            <dt>Seat Height Adjustment:</dt>
            <dd>Customizable Height for any desk</dd>
          </div>
          <div class="specs-row">
            <dt>Product Weight:</dt>
            <dd>42.6 lbs (19.3 kg)</dd>
          </div>
        </dl>
      </div>

      <div class="specs-card">
        <h3 class="specs-card-title">Materials & Build Quality</h3>
        <dl class="specs-dl">
          <div class="specs-row">
            <dt>Brand:</dt>
            <dd><strong class="text-primary">Ragaoon</strong></dd>
          </div>
          <div class="specs-row">
            <dt>Color:</dt>
            <dd>Black</dd>
          </div>
          <div class="specs-row">
            <dt>Upholstery:</dt>
            <dd>Easy-to-Clean Black PU Leather</dd>
          </div>
          <div class="specs-row">
            <dt>Internal Cushioning:</dt>
            <dd>16 Pocket Springs + High-Density Foam</dd>
          </div>
          <div class="specs-row">
            <dt>Frame Construction:</dt>
            <dd>Reinforced Steel with Sturdy Five-Star Base</dd>
          </div>
          <div class="specs-row">
            <dt>Max Weight Capacity:</dt>
            <dd><strong class="text-primary">150 kg (330 lbs)</strong></dd>
          </div>
          <div class="specs-row">
            <dt>Armrests:</dt>
            <dd>Synchronized (Moves with Backrest)</dd>
          </div>
          <div class="specs-row">
            <dt>Included in Box:</dt>
            <dd>Chair, Illustrated Instructions & Assembly Tools</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Specs",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Technical Specifications"
    }
  ],
  "presets": [
    {
      "name": "Product Specs"
    }
  ]
}
{% endschema %}
