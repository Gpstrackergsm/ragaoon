<section class="specs-section" id="Specs">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">Precision Dimensions</span>
      <h2 class="section-title">Technical Specifications & Engineering Blueprint</h2>
      <p class="section-desc">
        Crafted to fit users from 5'2" to 6'4" (157cm to 193cm) with ample room to move and recline comfortably.
      </p>
    </div>

    <div class="specs-grid">
      <div class="specs-card">
        <h3 class="specs-card-title">Dimensions & Geometry</h3>
        <dl class="specs-dl">
          <div class="specs-row">
            <dt>Overall Chair Height:</dt>
            <dd>125 cm &ndash; 133 cm (49.2" &ndash; 52.4")</dd>
          </div>
          <div class="specs-row">
            <dt>Seat Cushion Width:</dt>
            <dd>51 cm (20.1") &mdash; Flat Wingless Design</dd>
          </div>
          <div class="specs-row">
            <dt>Seat Cushion Depth:</dt>
            <dd>50 cm (19.7")</dd>
          </div>
          <div class="specs-row">
            <dt>Seat Cushion Thickness:</dt>
            <dd>12 cm (4.7") Pocket Spring Matrix</dd>
          </div>
          <div class="specs-row">
            <dt>Backrest Height:</dt>
            <dd>82 cm (32.3")</dd>
          </div>
          <div class="specs-row">
            <dt>Backrest Width:</dt>
            <dd>54 cm (21.3")</dd>
          </div>
          <div class="specs-row">
            <dt>Floor-to-Seat Height:</dt>
            <dd>45 cm &ndash; 53 cm (17.7" &ndash; 20.9")</dd>
          </div>
          <div class="specs-row">
            <dt>Footrest Extension:</dt>
            <dd>38 cm (15.0") Fully Extended</dd>
          </div>
        </dl>
      </div>

      <div class="specs-card">
        <h3 class="specs-card-title">Materials & Certifications</h3>
        <dl class="specs-dl">
          <div class="specs-row">
            <dt>Upholstery:</dt>
            <dd>Breathable Micro-Perforated PU Leather</dd>
          </div>
          <div class="specs-row">
            <dt>Internal Cushion:</dt>
            <dd>16 Independent Pocket Springs + 50D Molded Foam</dd>
          </div>
          <div class="specs-row">
            <dt>Recline Mechanism:</dt>
            <dd>90° to 135° Continuous Multi-Lock</dd>
          </div>
          <div class="specs-row">
            <dt>Gas Cylinder:</dt>
            <dd>SGS Class-4 Nitrogen Cylinder (TUV Approved)</dd>
          </div>
          <div class="specs-row">
            <dt>Chassis & Base:</dt>
            <dd>Reinforced 1.5mm Alloy Steel 5-Star Base</dd>
          </div>
          <div class="specs-row">
            <dt>Caster Wheels:</dt>
            <dd>60mm Ultra-Quiet PU Smooth-Glide Casters</dd>
          </div>
          <div class="specs-row">
            <dt>Max Weight Rating:</dt>
            <dd><strong class="text-primary">400 LBS (181 KG)</strong></dd>
          </div>
          <div class="specs-row">
            <dt>Included in Box:</dt>
            <dd>Chair, Footrest, Tools, Gloves, Assembly Guide</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Specs",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Technical Specifications"
    }
  ],
  "presets": [
    {
      "name": "Product Specs"
    }
  ]
}
{% endschema %}
