<section class="cushion-section" id="SpringSeat">
  <div class="container">
    <div class="cushion-inner-grid">
      <div class="cushion-visual-side">
        <div class="cushion-cutaway-card">
          <div class="cutaway-glow"></div>
          <div class="cutaway-header">
            <span class="badge-pill">Sofa-Grade Technology</span>
            <h3>16 Encased Pocket Springs + Resilient Molded Foam</h3>
          </div>

          <div class="layers-stack">
            <div class="layer-item layer-1">
              <span class="layer-num">1</span>
              <div>
                <strong>Breathable Black PU Leather</strong>
                <p>Wear-resistant, sweat-repellent, and effortless to wipe clean.</p>
              </div>
            </div>
            <div class="layer-item layer-2">
              <span class="layer-num">2</span>
              <div>
                <strong>High-Density Comfort Foam</strong>
                <p>Plush initial contact that cushions the hip and tailbone.</p>
              </div>
            </div>
            <div class="layer-item layer-3 layer-highlight">
              <span class="layer-num">3</span>
              <div>
                <strong>16-Pocket Spring Core Mattress Matrix</strong>
                <p>Independently reacting coils distribute pelvic weight evenly.</p>
              </div>
            </div>
            <div class="layer-item layer-4">
              <span class="layer-num">4</span>
              <div>
                <strong>Reinforced Alloy Steel Foundation</strong>
                <p>Zero-flex structural foundation built for longevity.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="cushion-text-side">
        <span class="section-tag">Seat Innovation</span>
        <h2 class="section-title">Why Traditional Foam Chairs Fail (And Why Pocket Springs Win)</h2>
        <p class="section-desc">
          Conventional gaming chairs use cheap recycled slab foam that packs down within 3 months, leaving your tailbone pressing against a hard steel plate.
        </p>

        <div class="comparison-points">
          <div class="compare-card compare-bad">
            <div class="compare-card-head">
              {% render 'icon', name: 'cross' %}
              <h4>Cheap Slab Foam Chairs</h4>
            </div>
            <ul>
              <li>Sags and compresses flat after 2-3 hours of sitting</li>
              <li>Sharp side wings squeeze thighs and force rigid posture</li>
              <li>Traps body heat, leading to uncomfortable sweating</li>
              <li>Causes sciatic nerve pinching and tailbone soreness</li>
            </ul>
          </div>

          <div class="compare-card compare-good">
            <div class="compare-card-head">
              {% render 'icon', name: 'check' %}
              <h4>Ragaoon Pocket Spring Seat</h4>
            </div>
            <ul>
              <li>16 pocket springs bounce back instantly &mdash; never bottoms out</li>
              <li>51cm flat wingless seat allows crossing legs or shifting positions</li>
              <li>Pocket coil air chambers allow continuous passive cooling</li>
              <li>Relieves 72% more pressure from pelvic bones</li>
            </ul>
          </div>
        </div>

        <div class="cushion-quote">
          <p>&ldquo;Sitting in the Ragaoon chair feels like floating on a high-end mattress instead of sitting on a hard bucket seat. My lower back pain disappeared after week one.&rdquo;</p>
          <cite>&mdash; Verified Ragaoon Customer & Remote Professional</cite>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cushion Engineering",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Sofa-Grade Pocket Springs"
    }
  ],
  "presets": [
    {
      "name": "Cushion Engineering"
    }
  ]
}
{% endschema %}
