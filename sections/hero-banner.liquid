<section class="hero-section" id="HeroSection">
  <div class="hero-ambient-glow"></div>
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        <span>Official Ragaoon Ergonomics</span>
      </div>

      <h1 class="hero-title">
        The Ergonomic Gaming Chair Engineered for <span class="text-gradient">Zero-Strain Comfort.</span>
      </h1>

      <p class="hero-subtitle">
        Upgrade your setup with the <strong>Ragaoon Ergonomic Gaming Chair</strong>. Featuring a spacious <strong>51 cm wingless seat</strong>, sofa-grade <strong>pocket spring & high-density foam cushioning</strong>, and a smooth <strong>90°–135° reclining backrest</strong> with synchronized armrests.
      </p>

      <div class="hero-action-row">
        <a href="#ProductOverview" class="btn btn-primary btn-lg hero-cta js-scroll-to-atc">
          <span>Order Ragaoon Chair &bull; $89.00 USD</span>
          {% render 'icon', name: 'arrow-right' %}
        </a>
        <a href="#VideoShowcase" class="btn btn-outline btn-lg hero-secondary">
          <span>Watch Product Video</span>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="hero-trust-bar">
        <div class="trust-pill">
          {% render 'icon', name: 'shield' %}
          <span>150 KG (330 LBS) Steel Frame</span>
        </div>
        <div class="trust-pill">
          {% render 'icon', name: 'check' %}
          <span>51cm Flat Wingless Seat</span>
        </div>
        <div class="trust-pill">
          {% render 'icon', name: 'refresh' %}
          <span>30-Day In-Home Trial</span>
        </div>
        <div class="trust-pill">
          {% render 'icon', name: 'truck' %}
          <span>Free Express Delivery</span>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-product-stage">
        <div class="hero-image-wrap">
          <img src="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.07.32.png?v=1792454958" alt="Ragaoon Ergonomic Gaming Chair" class="hero-chair-img" width="600" height="600" fetchpriority="high" decoding="async">
        </div>
        <!-- Floating Spec Callouts -->
        <div class="feature-tag feature-tag-1">
          <div class="tag-icon">⚡</div>
          <div class="tag-text">
            <strong>Synchronized Armrests</strong>
            <span>Pivots with 90°–135° recline</span>
          </div>
        </div>

        <div class="feature-tag feature-tag-2">
          <div class="tag-icon">🛋️</div>
          <div class="tag-text">
            <strong>Pocket Springs + Foam</strong>
            <span>Sofa-grade core, never sags</span>
          </div>
        </div>

        <div class="feature-tag feature-tag-3">
          <div class="tag-icon">🛡️</div>
          <div class="tag-text">
            <strong>Reinforced Steel Base</strong>
            <span>Supports up to 150 kg (330 lbs)</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Official Ragaoon Ergonomics"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Hero Title",
      "default": "The Ergonomic Gaming Chair Engineered for Zero-Strain Comfort."
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
