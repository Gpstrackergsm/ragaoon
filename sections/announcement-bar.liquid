<div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="announcement-container">
    <div class="announcement-item announcement-item-flash">
      {% render 'icon', name: 'zap' %}
      <span>{{ section.settings.flash_text }}</span>
    </div>
    <div class="announcement-item announcement-item-highlight">
      <span>{{ section.settings.center_text }}</span>
    </div>
    <div class="announcement-item announcement-item-trust">
      {% render 'icon', name: 'truck' %}
      <span>{{ section.settings.right_text }}</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#e63946"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "flash_text",
      "label": "Flash Offer Text",
      "default": "LIMITED LAUNCH: RAGAOON ERGONOMIC CHAIR ONLY $89.00 USD"
    },
    {
      "type": "text",
      "id": "center_text",
      "label": "Center Announcement",
      "default": "🔥 51cm Wingless Pocket Spring Cushion & 90°–135° Recline"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Right Highlight",
      "default": "FREE Delivery + 30-Day Risk-Free Trial"
    }
  ]
}
{% endschema %}
