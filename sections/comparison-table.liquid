<section class="comparison-section" id="Comparison">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">Value & Build Comparison</span>
      <h2 class="section-title">See How Ragaoon Crushes the Competition</h2>
      <p class="section-desc">
        Why pay $300–$500+ for a brand logo, or suffer in a flimsy $100 office stool? Get premium ergonomic engineering directly from Ragaoon for only $89.00 USD.
      </p>
    </div>

    <div class="table-responsive">
      <table class="comparison-table">
        <thead>
          <tr>
            <th class="feature-col">Ergonomic Feature</th>
            <th class="brand-col highlight-col">
              <span class="col-pill">Best Overall</span>
              <strong>Ragaoon</strong>
            </th>
            <th class="competitor-col">Generic Office Chair</th>
            <th class="competitor-col">Overpriced Racer Brand</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="feature-name">Seat Cushion Core</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} 16 Pocket Springs + High-Density Foam</span>
            </td>
            <td class="competitor-val">Thin Cut Foam (Sags quickly)</td>
            <td class="competitor-val">Hard Molded Foam (Rigid)</td>
          </tr>
          <tr>
            <td class="feature-name">Armrest Mechanism</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} Synchronized Linkage (Pivots with Recline)</span>
            </td>
            <td class="competitor-val">Fixed Plastic T-Arms</td>
            <td class="competitor-val">Rigid 2D/3D (Stays upright when reclined)</td>
          </tr>
          <tr>
            <td class="feature-name">Recline Capabilities</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} 90° to 135° Stepless Lock</span>
            </td>
            <td class="competitor-val">Slight Tilt Only (~105°)</td>
            <td class="competitor-val">90° to 135°</td>
          </tr>
          <tr>
            <td class="feature-name">Seat Cushion Width</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} 51 cm Wide Flat Wingless (Sit Cross-Legged)</span>
            </td>
            <td class="competitor-val">Narrow 38 cm Effective Seat</td>
            <td class="competitor-val">Narrow Bucket Seat with Metal Bolsters</td>
          </tr>
          <tr>
            <td class="feature-name">Steel Frame & Base</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} Reinforced Steel Frame (150 kg / 330 lbs)</span>
            </td>
            <td class="competitor-val">Nylon Base (100 kg)</td>
            <td class="competitor-val">Standard Steel Base (120 kg)</td>
          </tr>
          <tr>
            <td class="feature-name">Upholstery</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} Easy-to-Clean Black PU Leather</span>
            </td>
            <td class="competitor-val">Scratchy Mesh or Cheap Vinyl</td>
            <td class="competitor-val">Standard PU Leather</td>
          </tr>
          <tr>
            <td class="feature-name">In-Home Trial</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} 30-Day Risk-Free Trial</span>
            </td>
            <td class="competitor-val">14 Days / Restocking Fees</td>
            <td class="competitor-val">30 Days</td>
          </tr>
          <tr class="price-row">
            <td class="feature-name font-bold">Price</td>
            <td class="brand-val highlight-val">
              <span class="price-deal-text">$89.00 USD</span>
              <small class="block text-muted">Direct from Ragaoon</small>
            </td>
            <td class="competitor-val">$130 &ndash; $180</td>
            <td class="competitor-val">$350 &ndash; $500+</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="text-center mt-5">
      <a href="{{ routes.root_url }}#ProductOverview" class="btn btn-primary btn-lg">Claim Your Ragaoon Chair for $89.00 USD</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "See How Ragaoon Crushes the Competition"
    }
  ],
  "presets": [
    {
      "name": "Comparison Table"
    }
  ]
}
{% endschema %}
