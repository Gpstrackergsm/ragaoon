<section class="comparison-section" id="Comparison">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">Value & Build Comparison</span>
      <h2 class="section-title">See How JECQCUPG Crushes the Competition</h2>
      <p class="section-desc">
        Why pay $500+ for a brand logo, or suffer in a flimsy $100 office stool? Get premium ergonomic engineering at direct-to-consumer value.
      </p>
    </div>

    <div class="table-responsive">
      <table class="comparison-table">
        <thead>
          <tr>
            <th class="feature-col">Ergonomic Feature</th>
            <th class="brand-col highlight-col">
              <span class="col-pill">Best Overall</span>
              <strong>JECQCUPG</strong>
            </th>
            <th class="competitor-col">Generic Office Chair</th>
            <th class="competitor-col">Overpriced Racer Brand</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="feature-name">Seat Cushion Core</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} 16 Pocket Springs + High-Density Foam</span>
            </td>
            <td class="competitor-val">Thin Cut Foam (Sags quickly)</td>
            <td class="competitor-val">Hard Molded Foam (Rigid)</td>
          </tr>
          <tr>
            <td class="feature-name">Armrest Mechanism</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} Synchronized Linkage (Pivots with Recline)</span>
            </td>
            <td class="competitor-val">Fixed Plastic T-Arms</td>
            <td class="competitor-val">Rigid 2D/3D (Stays upright when reclined)</td>
          </tr>
          <tr>
            <td class="feature-name">Recline Capabilities</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} 90° to 135° Stepless Lock</span>
            </td>
            <td class="competitor-val">Slight Tilt Only (~105°)</td>
            <td class="competitor-val">90° to 135°</td>
          </tr>
          <tr>
            <td class="feature-name">Retractable Footrest</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} Included (High-Density Padded)</span>
            </td>
            <td class="competitor-val"><span class="val-no">{% render 'icon', name: 'cross' %} None</span></td>
            <td class="competitor-val"><span class="val-no">{% render 'icon', name: 'cross' %} Expensive Add-on (+$80)</span></td>
          </tr>
          <tr>
            <td class="feature-name">Seat Cushion Shape</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} 51cm Wide Flat Wingless (Sit Cross-Legged)</span>
            </td>
            <td class="competitor-val">Standard Small Seat</td>
            <td class="competitor-val">Narrow Bucket Seat with Metal Bolsters</td>
          </tr>
          <tr>
            <td class="feature-name">Max Weight Capacity</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} 400 LBS (181 KG) Heavy-Duty</span>
            </td>
            <td class="competitor-val">200 &ndash; 250 LBS</td>
            <td class="competitor-val">250 &ndash; 300 LBS</td>
          </tr>
          <tr>
            <td class="feature-name">Gas Lift Certification</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} SGS Class-4 Nitrogen Cylinder</span>
            </td>
            <td class="competitor-val">Class-2 or Uncertified</td>
            <td class="competitor-val">Class-4</td>
          </tr>
          <tr>
            <td class="feature-name">Warranty & In-Home Trial</td>
            <td class="brand-val highlight-val">
              <span class="val-badge-good">{% render 'icon', name: 'check' %} 30-Day Trial + 3-Year Warranty</span>
            </td>
            <td class="competitor-val">14 Days / 90 Days</td>
            <td class="competitor-val">30 Days / 2 Years</td>
          </tr>
          <tr class="price-row">
            <td class="feature-name font-bold">Price</td>
            <td class="brand-val highlight-val">
              <span class="price-deal-text">$199.99</span>
              <small class="block text-muted">Free Shipping</small>
            </td>
            <td class="competitor-val">$139 &ndash; $180</td>
            <td class="competitor-val">$450 &ndash; $600+</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="text-center mt-5">
      <a href="#ProductOverview" class="btn btn-primary btn-lg">Claim Your JECQCUPG Chair for $199.99</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "See How JECQCUPG Crushes the Competition"
    }
  ],
  "presets": [
    {
      "name": "Comparison Table"
    }
  ]
}
{% endschema %}
