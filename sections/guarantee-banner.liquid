<section class="guarantee-section">
  <div class="container">
    <div class="guarantee-card-box">
      <div class="guarantee-col" data-policy-trigger="refund" style="cursor: pointer;" title="Click to view 30-Day Return Trial Policy">
        <div class="guarantee-icon-wrap">
          {% render 'icon', name: 'refresh' %}
        </div>
        <h4 class="guarantee-col-title">30-Day Risk-Free Trial</h4>
        <p class="guarantee-col-desc">Try the Ragaoon chair at your desk for a full month. Not thrilled? Return it hassle-free for a 100% refund.</p>
      </div>

      <div class="guarantee-divider"></div>

      <div class="guarantee-col" data-policy-trigger="warranty" style="cursor: pointer;" title="Click to view 3-Year Hardware Warranty">
        <div class="guarantee-icon-wrap">
          {% render 'icon', name: 'shield' %}
        </div>
        <h4 class="guarantee-col-title">Durable Steel Frame &amp; 3-Yr Warranty</h4>
        <p class="guarantee-col-desc">Reinforced steel structure and sturdy five-star base built to support up to 150 kg (330 lbs).</p>
      </div>

      <div class="guarantee-divider"></div>

      <div class="guarantee-col" data-policy-trigger="shipping" style="cursor: pointer;" title="Click to view Shipping &amp; Delivery Policy">
        <div class="guarantee-icon-wrap">
          {% render 'icon', name: 'truck' %}
        </div>
        <h4 class="guarantee-col-title">Fast Express Delivery</h4>
        <p class="guarantee-col-desc">Direct dispatch with step-by-step parcel tracking straight to your door (2-4 Days).</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee Banner",
  "settings": [],
  "presets": [
    {
      "name": "Guarantee Banner"
    }
  ]
}
{% endschema %}
