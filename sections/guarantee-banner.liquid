<section class="guarantee-section">
  <div class="container">
    <div class="guarantee-card-box">
      <div class="guarantee-col">
        <div class="guarantee-icon-wrap">
          {% render 'icon', name: 'refresh' %}
        </div>
        <h4 class="guarantee-col-title">30-Day Risk-Free Trial</h4>
        <p class="guarantee-col-desc">Try the JECQCUPG chair at your desk for a full month. Not thrilled? Return it hassle-free for a 100% refund.</p>
      </div>

      <div class="guarantee-divider"></div>

      <div class="guarantee-col">
        <div class="guarantee-icon-wrap">
          {% render 'icon', name: 'shield' %}
        </div>
        <h4 class="guarantee-col-title">3-Year Factory Warranty</h4>
        <p class="guarantee-col-desc">Complete coverage on the structural steel frame, Class-4 gas cylinder, tilt mechanism, and casters.</p>
      </div>

      <div class="guarantee-divider"></div>

      <div class="guarantee-col">
        <div class="guarantee-icon-wrap">
          {% render 'icon', name: 'truck' %}
        </div>
        <h4 class="guarantee-col-title">Free Express US Delivery</h4>
        <p class="guarantee-col-desc">Every order ships free from our local fulfillment centers with step-by-step parcel tracking.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee Banner",
  "settings": [],
  "presets": [
    {
      "name": "Guarantee Banner"
    }
  ]
}
{% endschema %}
