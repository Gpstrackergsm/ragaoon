<section class="faq-section" id="FAQ">
  <div class="container faq-container">
    <div class="section-header text-center">
      <span class="section-tag">Got Questions?</span>
      <h2 class="section-title">Frequently Asked Questions</h2>
      <p class="section-desc">
        Everything you need to know about the Ragaoon Ergonomic Gaming Chair, shipping, warranty, and assembly.
      </p>
    </div>

    <div class="faq-accordion-list">
      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          <span class="faq-question">How difficult is the assembly, and do I need my own tools?</span>
          <span class="faq-icon">{% render 'icon', name: 'chevron-down' %}</span>
        </button>
        <div class="faq-answer">
          <p>
            Assembly is quick and frustration-free, taking only <strong>15 to 20 minutes</strong>. The Ragaoon chair package comes with clear illustrated instructions and all the necessary assembly tools included in the box. No external tools are required.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          <span class="faq-question">What is the weight capacity and build of the Ragaoon chair?</span>
          <span class="faq-icon">{% render 'icon', name: 'chevron-down' %}</span>
        </button>
        <div class="faq-answer">
          <p>
            The Ragaoon chair is engineered with a reinforced steel construction and a sturdy five-star base that supports up to <strong>150 kg (330 lbs)</strong>. Its product dimensions are 55.3" D &times; 28.27" W &times; 28.28" H with a net weight of 42.6 lbs.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          <span class="faq-question">How do the synchronized armrests work with the recline?</span>
          <span class="faq-icon">{% render 'icon', name: 'chevron-down' %}</span>
        </button>
        <div class="faq-answer">
          <p>
            The Ragaoon armrests are synchronized to tilt automatically with the backrest as you recline from <strong>90° to 135°</strong>. Your arms stay properly supported whether you are sitting upright typing, browsing casually, or resting.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          <span class="faq-question">What makes the 51 cm wingless seat cushion so comfortable?</span>
          <span class="faq-icon">{% render 'icon', name: 'chevron-down' %}</span>
        </button>
        <div class="faq-answer">
          <p>
            Unlike traditional bucket seats with high side wings that squeeze your thighs, Ragaoon features a flat, wingless <strong>51 cm wide seat</strong>. It combines high-density foam with <strong>16 durable pocket springs</strong> (just like a luxury sofa) to prevent bottoming out and allow you to sit naturally or cross-legged.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          <span class="faq-question">How do I clean and maintain the PU leather?</span>
          <span class="faq-icon">{% render 'icon', name: 'chevron-down' %}</span>
        </button>
        <div class="faq-answer">
          <p>
            The sleek black PU leather upholstery is wear-resistant and water-repellent. Simply wipe it down with a damp microfiber cloth to remove dust, spills, or sweat in seconds.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          <span class="faq-question">What is Ragaoon's trial period and return policy?</span>
          <span class="faq-icon">{% render 'icon', name: 'chevron-down' %}</span>
        </button>
        <div class="faq-answer">
          <p>
            Every Ragaoon chair comes with a <strong>30-Day Risk-Free Trial</strong>. Test it at your desk for a full month. If you are not completely satisfied with the comfort and support, contact our team for an easy return.
          </p>
        </div>
      </div>
    </div>

    <div class="text-center mt-5">
      <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 28px; max-width: 600px; margin: 0 auto 20px auto;">
        <h4 style="font-size: 1.2rem; margin-bottom: 8px;">Still Deciding? Test It 100% Risk-Free.</h4>
        <p class="text-muted" style="font-size: 0.9rem; margin-bottom: 18px;">Sit on the 51 cm pocket spring seat in your own home for 30 days. Feel the difference in your back and posture, or receive a prompt 100% refund.</p>
        <a href="{{ routes.root_url }}#ProductOverview" class="btn btn-primary btn-lg">
          <span>Claim 30-Day Risk-Free Trial &bull; $89.00 USD</span>
          {% render 'icon', name: 'arrow-right' %}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Frequently Asked Questions"
    }
  ],
  "presets": [
    {
      "name": "FAQ Section"
    }
  ]
}
{% endschema %}
