{%- assign current_product = all_products[section.settings.featured_product] -%}
{%- if current_product == empty or current_product == blank -%}
  {%- assign current_product = all_products['ragaoon-ergonomic-gaming-chair'] -%}
{%- endif -%}
{%- if current_product == empty or current_product == blank -%}
  {%- assign current_product = product -%}
{%- endif -%}
{%- if current_product == empty or current_product == blank -%}
  {%- assign current_product = collections.all.products.first -%}
{%- endif -%}

{%- assign current_variant = current_product.selected_or_first_available_variant -%}
{%- assign current_variant_id = current_variant.id | default: 67868873621716 -%}

<section class="product-section" id="ProductOverview">
  <div class="container product-container">
    <!-- Gallery Column -->
    <div class="product-gallery-col">
      <div class="product-gallery-main">
        <div class="gallery-badge-floating">
          <span class="badge-discount">SAVE $50</span>
          <span class="badge-bestseller">Official Ragaoon</span>
        </div>
        <img id="MainProductImage" src="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.07.32.png?v=1792454958" alt="Ragaoon Ergonomic Gaming Chair - Black" class="gallery-active-img">
      </div>

      <!-- 9 Real Product Image Thumbnails from ragaoon.com.co -->
      <div class="product-gallery-thumbs" id="GalleryThumbs">
        <button type="button" class="thumb-btn active" data-img="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.07.32.png?v=1792454958">
          <img src="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.07.32.png?v=1792454958" alt="Front Ergonomic View">
          <span>Main</span>
        </button>
        <button type="button" class="thumb-btn" data-img="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.07.55.png?v=1792454958">
          <img src="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.07.55.png?v=1792454958" alt="7-Point Support">
          <span>7-Point</span>
        </button>
        <button type="button" class="thumb-btn" data-img="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.02.png?v=1792454958">
          <img src="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.02.png?v=1792454958" alt="51cm Wingless Seat">
          <span>51cm Seat</span>
        </button>
        <button type="button" class="thumb-btn" data-img="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.11.png?v=1792454957">
          <img src="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.11.png?v=1792454957" alt="Pocket Springs + Foam">
          <span>Springs</span>
        </button>
        <button type="button" class="thumb-btn" data-img="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.20.png?v=1792454958">
          <img src="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.20.png?v=1792454958" alt="90-135 Recline & Armrests">
          <span>Recline</span>
        </button>
        <button type="button" class="thumb-btn" data-img="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.27.png?v=1792454958">
          <img src="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.27.png?v=1792454958" alt="Steel Frame 150kg Load">
          <span>Steel Base</span>
        </button>
        <button type="button" class="thumb-btn" data-img="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.35.png?v=1792454958">
          <img src="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.35.png?v=1792454958" alt="Dimensions">
          <span>Dimensions</span>
        </button>
        <button type="button" class="thumb-btn" data-img="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.42.png?v=1792454958">
          <img src="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.42.png?v=1792454958" alt="PU Leather Detail">
          <span>PU Leather</span>
        </button>
        <button type="button" class="thumb-btn" data-img="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.49.png?v=1792454957">
          <img src="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.08.49.png?v=1792454957" alt="Easy Assembly">
          <span>Assembly</span>
        </button>
      </div>

      <!-- Trust Mini Badges below gallery -->
      <div class="gallery-trust-strip">
        <div class="trust-mini-item">
          {% render 'icon', name: 'truck' %}
          <div>
            <strong>Fast Express Delivery</strong>
            <small>Direct from warehouse</small>
          </div>
        </div>
        <div class="trust-mini-item">
          {% render 'icon', name: 'refresh' %}
          <div>
            <strong>30-Day Risk-Free Trial</strong>
            <small>Love it or 100% money back</small>
          </div>
        </div>
        <div class="trust-mini-item">
          {% render 'icon', name: 'shield' %}
          <div>
            <strong>3-Year Frame Warranty</strong>
            <small>Reinforced steel build</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Product Form & Details Column -->
    <div class="product-info-col">
      <!-- Reviews Header -->
      <div class="product-rating-header">
        <div class="stars-group">
          {% for i in (1..5) %}
            {% render 'icon', name: 'star' %}
          {% endfor %}
        </div>
        <a href="#Reviews" class="rating-link"><strong>4.9 / 5.0</strong> &bull; Verified Ragaoon Owners</a>
        <span class="stock-pill">⚡ In Stock, Ships in 24h</span>
      </div>

      <h1 class="product-page-title">
        {{ current_product.title | default: "Ragaoon Ergonomic Gaming Chair" }}
      </h1>
      <p class="product-page-subtitle">
        Upgrade your gaming setup or workspace with the Ragaoon Ergonomic Gaming Chair, designed for lasting comfort, flexible seating, and reliable support. Featuring a spacious 51 cm wingless seat, premium-style pocket spring cushioning, and an adjustable 90°–135° reclining backrest.
      </p>

      <!-- Pricing Box -->
      <div class="product-price-box">
        <div class="price-main-row">
          <span class="price-current-large" id="ProductPrice">
            {% if current_product.price %}
              {{ current_product.price | money }}
            {% else %}
              $89.00 USD
            {% endif %}
          </span>
          <s class="price-compare-large" id="ProductComparePrice">
            {% if current_product.compare_at_price > current_product.price %}
              {{ current_product.compare_at_price | money }}
            {% else %}
              $139.00 USD
            {% endif %}
          </s>
          <span class="price-discount-pill">SAVE $50 (36% OFF)</span>
        </div>
        <div class="installments-row">
          <span>Or 4 interest-free payments of <strong>$22.25</strong> with</span>
          <span class="bnpl-badge">Klarna</span>
          <span class="bnpl-badge">afterpay</span>
        </div>
      </div>

      <!-- Live Scarcity & Countdown -->
      <div class="stock-scarcity-card">
        <div class="scarcity-header">
          <span class="scarcity-fire">🔥 Limited Production Batch:</span>
          <span>Only <strong>6 chairs</strong> remaining at promotional price!</span>
        </div>
        <div class="scarcity-progress-bar">
          <div class="scarcity-progress-fill" style="width: 88%;"></div>
        </div>
        <div class="scarcity-timer">
          <span>Order within <strong id="CountdownTimer">03h 42m 19s</strong> for same-day dispatch.</span>
        </div>
      </div>

      <!-- Color Variant Selector -->
      <div class="variant-selection-area">
        <div class="variant-header-row">
          <label class="variant-label">
            Selected Color: <span class="selected-color-name" id="SelectedColorName">Black</span>
          </label>
          <span class="variant-availability">In Stock</span>
        </div>

        <div class="swatches-grid" style="grid-template-columns: 1fr;">
          <label class="swatch-option active" data-color="Black" data-price="$89.00 USD" data-compare="$139.00 USD" data-img="https://cdn.shopify.com/s/files/1/0863/8509/8964/files/Screenshot2026-10-20at00.07.32.png?v=1792454958">
            <input type="radio" name="color_variant" value="Black" checked>
            <span class="swatch-circle swatch-jet-black"></span>
            <span class="swatch-text">Ragaoon Stealth Black &bull; High-Density PU Leather</span>
            <span class="swatch-tag">Signature Edition</span>
          </label>
        </div>
      </div>

      <!-- Add to Cart Form -->
      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="MainAddToCartForm" class="product-purchase-form">
        <input type="hidden" name="id" id="ProductVariantIdInput" value="{{ current_variant_id }}">
        <input type="hidden" name="quantity" id="ProductQuantityInput" value="1">

        <div class="form-cta-row">
          <div class="qty-stepper-box">
            <button type="button" class="stepper-btn" id="QtyMinus" aria-label="Decrease quantity">-</button>
            <span class="stepper-val" id="QtyDisplay">1</span>
            <button type="button" class="stepper-btn" id="QtyPlus" aria-label="Increase quantity">+</button>
          </div>

          <button type="button" class="btn btn-primary btn-lg main-atc-btn" id="MainAddToCartBtn">
            {% render 'icon', name: 'cart' %}
            <span>Add To Cart &bull; $89.00 USD</span>
          </button>
        </div>

        <button type="button" class="btn btn-accent btn-lg btn-block buy-now-btn" id="MainBuyNowBtn">
          {% render 'icon', name: 'zap' %}
          <span>Instant Checkout (1-Click)</span>
        </button>
      </form>

      <!-- Key Features List directly from ragaoon.com.co -->
      <div class="product-checklist">
        <div class="check-item">
          {% render 'icon', name: 'check' %}
          <span><strong>Ergonomic Body Support:</strong> Targeted support for head, neck, shoulders, back, lumbar, hips, and legs.</span>
        </div>
        <div class="check-item">
          {% render 'icon', name: 'check' %}
          <span><strong>51 cm Wingless Seat:</strong> Wide flat cushion allows natural sitting, stretching, or sitting cross-legged.</span>
        </div>
        <div class="check-item">
          {% render 'icon', name: 'check' %}
          <span><strong>Premium Cushioning:</strong> High-density foam combined with 16 pocket springs delivers sofa-grade bounce.</span>
        </div>
        <div class="check-item">
          {% render 'icon', name: 'check' %}
          <span><strong>Adjustable Recline (90°–135°):</strong> Seamless transition between focused work and zero-strain relaxation.</span>
        </div>
        <div class="check-item">
          {% render 'icon', name: 'check' %}
          <span><strong>Synchronized Armrests:</strong> Moves dynamically with the backrest to maintain forearm alignment.</span>
        </div>
        <div class="check-item">
          {% render 'icon', name: 'check' %}
          <span><strong>Durable Steel Frame:</strong> 150 kg (330 lbs) maximum load rating with reinforced 5-star base.</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Product Section",
  "settings": [
    {
      "type": "product",
      "id": "featured_product",
      "label": "Select Product (Optional)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Ragaoon Ergonomic Gaming Chair"
    }
  ],
  "presets": [
    {
      "name": "Main Product Section"
    }
  ]
}
{% endschema %}
